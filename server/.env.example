# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rukhalt_db
DB_USER=rukhalt_user
DB_PASSWORD=rukhalt_password
DB_SSL_MODE=disable

# Server Configuration
PORT=8080
GIN_MODE=debug

# JWT Configuration
JWT_SECRET=your-jwt-secret-change-this-in-production

# Encryption Key for sensitive data (passwords, SSH keys)
ENCRYPTION_KEY=your-encryption-key-change-this-in-production-32-chars-minimum




# Production Environment Variables
# Copy this to .env.prod and update with your production values

