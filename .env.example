# Docker Hub username (CHANGE THIS!)
DOCKER_USERNAME=your-dockerhub-username

# Domain Configuration (for SSL setup in production)
DOMAIN=yourdomain.com
EMAIL=your-email@example.com

# Database Configuration
DB_HOST=postgres
DB_NAME=rustfs_manager
DB_USER=rustfs_user
DB_PASSWORD=rustfs_password

# JWT Configuration (CHANGE THIS!)
JWT_SECRET=your-jwt-secret-change-this-in-production
# On your local machine, update frontend to use HTTPS
REACT_APP_API_URL=https://storage-manager.zendevz.com/api/v1
